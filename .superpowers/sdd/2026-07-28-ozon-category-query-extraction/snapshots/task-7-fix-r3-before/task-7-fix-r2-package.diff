# Task 7 fix r2 scoped review package
# Base: snapshots/task-7-fix-r2-before/{App.jsx,category-readiness.js,category-readiness.test.mjs}
# Reviewed issue: prevent a locally stale A item/preview from being consumed while
# binding/localStorage have moved to B. No store-name matching is introduced.

diff --git a/app/src/category-readiness.js b/app/src/category-readiness.js
@@
+export function categoryItemScopeIsCurrent({ currentStoreId, localStateStoreId, itemStoreId } = {}) {
+  const current = String(currentStoreId || "");
+  const local = String(localStateStoreId || "");
+  const item = String(itemStoreId || "");
+  return Boolean(current && local && item && current === local && local === item);
+}

