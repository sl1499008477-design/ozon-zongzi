QH_LOCAL_API_PORT=3001
QH_LOCAL_DATA_DIR=server-data

# 本地管理员账号。生产分发时请修改密码。
SONLI_ADMIN_USERNAME=admin
SONLI_ADMIN_PASSWORD=admin123456

# 正式部署必须修改。用于加密 Ozon Api-Key 等敏感字段，修改后旧密文无法解密。
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY_VERSION=v1

# PostgreSQL。配置 POSTGRES_HOST 后，后端状态会写入 PostgreSQL；未配置时回退到 server-data/local-state.json。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sonli_local
POSTGRES_USER=sonli
POSTGRES_PASSWORD=sonli_password
POSTGRES_SSL=false
POSTGRES_STATE_TABLE=local_state

# MinIO。本地文件接口 /local/files 使用该 bucket 保存图片、视频和文件。
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sonli_minio
MINIO_SECRET_KEY=sonli_minio_password
MINIO_BUCKET=sonli-local-files
LOCAL_FILE_MAX_BYTES=52428800
