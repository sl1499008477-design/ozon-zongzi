QH_LOCAL_API_PORT=3001
QH_LOCAL_DATA_DIR=server-data
VITE_LOCAL_API_BASE=/api

# 本地管理员账号。密码必须自行生成，不提供公共默认值。
SONLI_ADMIN_USERNAME=admin
SONLI_ADMIN_PASSWORD=

# 用于加密 Ozon Api-Key 等敏感字段；至少 32 个随机字符，修改后旧密文无法解密。
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=v1

# PostgreSQL。配置 POSTGRES_HOST 后，后端状态会写入 PostgreSQL；未配置时回退到 server-data/local-state.json。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sonli_local
POSTGRES_USER=sonli
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_STATE_TABLE=local_state

# V3 正式上架流水线。API 只创建不可变快照和 Outbox 事件，独立 Worker 调用 Ozon。
LISTING_PIPELINE_V3=1
PG_BOSS_SCHEMA=sonli_queue
PG_BOSS_APPLICATION_NAME=sonli-listing-worker
PG_BOSS_POOL_SIZE=5
LISTING_WORKER_CONCURRENCY=2
LISTING_MAX_STATUS_CHECKS=240
LISTING_QUEUE_RETRY_LIMIT=2
LISTING_QUEUE_RETRY_DELAY_SECONDS=5
LISTING_QUEUE_EXPIRE_SECONDS=300
LISTING_QUEUE_RETENTION_SECONDS=1209600
LISTING_QUEUE_DELETE_AFTER_SECONDS=604800

# 上架规则版本会写入草稿修订和不可变快照，便于问题追溯。
OZON_CATEGORY_RULE_VERSION=2026-07-v1
OZON_DICTIONARY_VERSION=live-api
OZON_RICH_CONTENT_RULE_VERSION=2026-07-v1

# MinIO。本地文件接口 /local/files 使用该 bucket 保存图片、视频和文件。
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sonli-local-files
MINIO_CONSOLE_PORT=9001
LOCAL_FILE_MAX_BYTES=52428800

# Web 对外监听端口必须显式选择，避免静默占用已有服务端口。
WEB_PORT=3000
